# Supabase Credentials (Vite / Browser client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (used by the send-notification Supabase Edge Function,
# set via `supabase secrets set`, never exposed to the browser bundle)
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional: defaults to https://servicecalls.vercel.app if unset
PORTAL_URL=
